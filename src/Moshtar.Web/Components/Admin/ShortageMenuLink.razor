@* "Tekorten" in het menu, met een teller: hoeveel keer een reservatie getroffen is door een tekort. *@
@inject IShortageOverview Shortages

<MudNavLink Href="admin/tekorten" Icon="@Icons.Material.Filled.ReportProblem">
    Tekorten
    @if (_count > 0)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2" data-shortage-count="@_count">@_count</MudChip>
    }
</MudNavLink>

@code {
    private int _count;

    protected override async Task OnInitializedAsync() => _count = await Shortages.CountAsync();
}
