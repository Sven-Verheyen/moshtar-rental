@* De teller van de tekorten in het menu: hoeveel keer een reservatie getroffen is door een tekort. Naast Tekorten, en naast het
   onderdeel Reservaties als dat dicht is. *@
@if (Count > 0)
{
    @if (Part)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2" data-part-shortage-count="@Count">@Count</MudChip>
    }
    else
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2" data-shortage-count="@Count">@Count</MudChip>
    }
}

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Part { get; set; }
}
