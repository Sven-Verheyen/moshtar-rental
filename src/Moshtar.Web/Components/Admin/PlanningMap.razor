@using System.Text.Json
@using Moshtar.Application.Schedule
@using Moshtar.Domain.Common
@using Moshtar.Domain.Rounds
@implements IAsyncDisposable
@inject IJSRuntime JS

@* De kaart van één dag (Azure Maps, ADR 0006): de stops van de leverronde en de ophaalronde, en het bedrijfsadres;
   van een ronde met een route ook de route, met de stops genummerd in volgorde.
   De punten staan in data-attributen; het script tekent ze. Zonder sleutel geen kaart, de rest van de planning werkt gewoon. *@
@if (MapKey is null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" data-map="geen">
        Geen kaart: Azure Maps is niet ingesteld. Waarschuwingen, adressen verbeteren en spelden (met coördinaten) werken wel.
    </MudAlert>
}
else
{
    <div id="planning-kaart" class="@($"planning-map mb-3{(Pinning ? " planning-map-pinning" : "")}")"
         data-bedrijf="@Day.BusinessPoint" data-stops="@StopsJson"></div>
}

@code {
    [Parameter, EditorRequired] public ScheduleDay Day { get; set; } = default!;

    /// <summary>De browsersleutel van Azure Maps (enkel kaarttegels); null: geen kaart.</summary>
    [Parameter] public string? MapKey { get; set; }

    /// <summary>Wordt er een speld gezet? Dan zet een klik op de kaart de speld, en die kan nog versleept worden.</summary>
    [Parameter] public bool Pinning { get; set; }

    [Parameter] public EventCallback<GeoPoint> OnPinPlaced { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<PlanningMap>? _self;
    private string? _drawn;
    private bool? _pinning;

    /// <summary>
    /// Elke stop met een punt, in de volgorde van de ronde, met zijn plaats in de route (volgorde) als de ronde een
    /// route heeft. Een stop zonder punt kan niet op de kaart.
    /// </summary>
    private string StopsJson => JsonSerializer.Serialize(
        Day.Deliveries.Select(s => (Stop: s, Round: RoundKind.Delivery.Slug()))
            .Concat(Day.Collections.Select(s => (Stop: s, Round: RoundKind.Collection.Slug())))
            .Where(x => x.Stop.Point is not null)
            .Select(x => new { nummer = x.Stop.Number, klant = x.Stop.CustomerName, ronde = x.Round, punt = x.Stop.Point!.ToString(), volgorde = x.Stop.InRound?.Position }));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MapKey is null) return;
        var drawn = $"{Day.BusinessPoint}|{StopsJson}";
        if (drawn == _drawn && Pinning == _pinning) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Admin/PlanningMap.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            if (drawn != _drawn) await _module.InvokeVoidAsync("show", "planning-kaart", MapKey, _self);
            if (Pinning != _pinning) await _module.InvokeVoidAsync("pin", "planning-kaart", Pinning);
            (_drawn, _pinning) = (drawn, Pinning);
        }
        catch (JSException)
        {
            // De kaart laadt niet (geen verbinding met Azure Maps): de planning zelf werkt verder.
        }
    }

    [JSInvokable]
    public Task PinPlaced(double latitude, double longitude) =>
        GeoPoint.IsValid(latitude, longitude) ? OnPinPlaced.InvokeAsync(new GeoPoint(latitude, longitude)) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", "planning-kaart");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _self?.Dispose();
    }
}
