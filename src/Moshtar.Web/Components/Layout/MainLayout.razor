@inherits LayoutComponentBase
@inject ITenantContext TenantContext
@inject SiteLinks Links
@inject IStringLocalizer<SharedResource> L
@inject ICartService Carts
@using Moshtar.Domain.Tenants

@* Het standaardsjabloon van de reservatiewebsite. Een ander sjabloon is later een andere layout met een eigen stylesheet. *@
<a class="skip-link" href="#inhoud">@L["SkipToContent"]</a>

<header class="site-header">
    <div class="site-header-inner">
        <a class="brand" href="@Links.Href(SiteRoute.Home)">
            @if (Moshtar.Domain.Tenants.Branding.LogoUrl(Tenant?.LogoUrl) is { } logo)
            {
                <img src="@logo" alt="@Tenant!.Name" height="48" />
            }
            else
            {
                @Tenant?.Name
            }
        </a>
        <nav class="site-nav" aria-label="@L["MainMenu"]">
            <a href="@OfferHref">@L["Catalog"]</a>
            <a href="@Links.Href(SiteRoute.Faq)" aria-current="@(Links.Current is FaqRoute ? "page" : null)">@L["FaqShort"]</a>
            <a href="@Links.Href(SiteRoute.Contact)" aria-current="@(Links.Current is ContactRoute ? "page" : null)">@L["Contact"]</a>
        </nav>
        <nav class="languages" aria-label="@L["ChooseLanguage"]">
            @foreach (var culture in Links.Cultures)
            {
                <a href="@Links.Href(Links.Current ?? SiteRoute.Home, culture)" hreflang="@culture" lang="@culture"
                   title="@CultureInfo.GetCultureInfo(culture).NativeName"
                   aria-current="@(culture == Links.Culture ? "page" : null)">@culture.ToUpperInvariant()</a>
            }
        </nav>
        <a class="cart-link" href="@Links.Href(SiteRoute.Cart)" aria-label="@L["CartWithCount", _cartCount]"
           aria-current="@(Links.Current is CartRoute ? "page" : null)">
            <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h3l2.7 12.4a1.5 1.5 0 0 0 1.5 1.1h8.9a1.5 1.5 0 0 0 1.5-1.2L21 7H6" /></svg>
            @if (_cartCount > 0)
            {
                <span class="cart-count">@_cartCount</span>
            }
        </a>
        <a class="button cta" href="@ChooseDateHref">@L["ChooseDate"]</a>
    </div>
</header>

<main id="inhoud" class="site-main">
    @Body
</main>

<footer class="site-footer">
    <div class="site-footer-inner">
        <address>
            <strong>@Tenant?.Name</strong>
            @if (Tenant?.Street is { } street)
            {
                <span>@street</span>
            }
            @if (PostalCodeAndCity is { Length: > 0 } place)
            {
                <span>@place</span>
            }
            @if (BusinessDetails.Email(Tenant?.ContactEmail) is { } email)
            {
                <a href="mailto:@email">@email</a>
            }
            @if (BusinessDetails.Phone(Tenant?.ContactPhone) is { } phone)
            {
                <a href="tel:@BusinessDetails.TelLink(phone)">@phone</a>
            }
            @if (Tenant?.VatNumber is { } vat)
            {
                <span>@L["VatNumber"] @vat</span>
            }
        </address>
        @if (SocialLinks.Count > 0)
        {
            <nav class="social" aria-label="@L["FollowUs"]">
                @foreach (var (name, url) in SocialLinks)
                {
                    <a href="@url" rel="me noopener" target="_blank">@name</a>
                }
            </nav>
        }
        @if (BusinessDetails.Link(Tenant?.GoogleBusinessUrl) is { } google)
        {
            <p><a href="@google" rel="noopener" target="_blank">@L["GoogleReviews"]</a></p>
        }
        <p class="muted">
            <span>© @DateTime.Today.Year @Tenant?.Name</span>
            <a href="@Links.Href(SiteRoute.Privacy)" aria-current="@(Links.Current is PrivacyRoute ? "page" : null)">@L["Privacy"]</a>
            @if (AnalyticsConsent.MeasurementId(Tenant) is not null && HttpContext is not null)
            {
                <a href="@AnalyticsConsent.ChangePath?terug=@Uri.EscapeDataString(AnalyticsConsent.ReturnUrl(HttpContext))" rel="nofollow">@L["CookieSettings"]</a>
            }
        </p>
    </div>
</footer>

@* De toestemmingsbalk voor Google Analytics: een gewoon formulier, zonder JavaScript. Hij plakt onderaan het scherm en
   schuift aan het einde van de pagina onder de footer, zodat hij niets definitief bedekt. *@
@if (AnalyticsConsent.MustAsk(HttpContext, Tenant))
{
    <form class="consent" method="post" action="@AnalyticsConsent.ChoosePath" aria-label="@L["CookieSettings"]">
        <p>@L["ConsentText"] <a href="@Links.Href(SiteRoute.Privacy)">@L["Privacy"]</a></p>
        <AntiforgeryToken />
        <input type="hidden" name="terug" value="@AnalyticsConsent.ReturnUrl(HttpContext!)" />
        <div class="consent-choices">
            <button class="button" type="submit" name="keuze" value="ja">@L["Accept"]</button>
            <button class="button" type="submit" name="keuze" value="nee">@L["Decline"]</button>
        </div>
    </form>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private Moshtar.Domain.Tenants.Tenant? Tenant => TenantContext.Tenant;
    private int _cartCount;

    protected override async Task OnInitializedAsync() =>
        _cartCount = await Carts.CountAsync(CartEndpoints.Key(HttpContext));
    private string? PostalCodeAndCity => $"{Tenant?.PostalCode} {Tenant?.City}".Trim();

    private IReadOnlyList<(string Name, string Url)> SocialLinks =>
        new[] { ("Facebook", Tenant?.FacebookUrl), ("Instagram", Tenant?.InstagramUrl), ("TikTok", Tenant?.TikTokUrl) }
            .Where(s => BusinessDetails.Link(s.Item2) is not null)
            .Select(s => (s.Item1, BusinessDetails.Link(s.Item2)!))
            .ToList();

    private string OfferHref => Links.Href(SiteRoute.Home) + "#aanbod";

    /// <summary>
    /// De knop springt naar het formulier "Kies je datum": op de pagina van een artikel bij het reserveren, op een
    /// categoriepagina bovenaan de lijst, elders op de home.
    /// </summary>
    private string ChooseDateHref => Links.Current switch
    {
        RentalRoute => "#reserveren",
        CategoryRoute => "#datum",
        _ => Links.Href(SiteRoute.Home) + "#datum",
    };
}
