@inherits LayoutComponentBase
@inject ITenantContext TenantContext
@inject SiteLinks Links

<SiteHead />

<header class="site-header">
    <a class="brand" href="@Links.Href(SiteRoute.Home)">@TenantContext.Tenant?.Name</a>
    <nav class="languages">
        @foreach (var culture in Links.Cultures)
        {
            <a href="@Links.Href(Links.Current ?? SiteRoute.Home, culture)" hreflang="@culture" lang="@culture"
               class="@(culture == Links.Culture ? "active" : null)">@culture.ToUpperInvariant()</a>
        }
    </nav>
</header>

<main class="site-main">
    @Body
</main>

<footer class="site-footer">
    @TenantContext.Tenant?.Name
    @if (TenantContext.Tenant?.ContactEmail is { } email)
    {
        <a href="mailto:@email">@email</a>
    }
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
