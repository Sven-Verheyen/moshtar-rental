@inject IStringLocalizer<SharedResource> L
@inject IPriceQuotes Prices

@* Met een huurperiode: wat vrij is bovenaan, de rest met "niet vrij op deze datum". De volgorde blijft verder die van de catalogus.
*@
<div class="catalog-grid">
    @foreach (var entry in Entries.OrderBy(e => Unavailable.Contains(e.Id)))
    {
        <CatalogCard Entry="entry" Chosen="Chosen" Unavailable="Unavailable.Contains(entry.Id)" Quoter="_quoter" />
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CatalogEntry> Entries { get; set; } = [];
    [Parameter] public ChosenPeriod Chosen { get; set; } = ChosenPeriod.None;
    [Parameter] public IReadOnlySet<Guid> Unavailable { get; set; } = new HashSet<Guid>();

    private PriceQuoter? _quoter;

    /// <summary>
    /// De prijsregels, één keer voor alle kaarten: met een huurperiode voor de prijs met periodeprijzen, en met of
    /// zonder voor de acties.
    /// </summary>
    protected override async Task OnParametersSetAsync() => _quoter ??= await Prices.CurrentAsync();
}
