@inject IStringLocalizer<SharedResource> L
@inject SiteLinks Links

@{
    var href = Links.Href(new RentalRoute(Entry.Slug)) + Chosen.Query;
    // Met een gekozen huurperiode de prijs met periodeprijzen, zonder de dagprijs; telkens met de actie die geldt.
    var price = Quoter?.SitePriceFor(Entry, Chosen.Period)
        ?? (Chosen.Period is { } chosen ? new SitePrice(Entry.PriceFor(chosen.Days), Entry.PriceFor(chosen.Days), null) : new SitePrice(Entry.DayPrice, Entry.DayPrice, null));
}
<article class="catalog-card @(Unavailable ? "unavailable" : null)">
    @if (Entry.MainPhoto is { } photo)
    {
        <SitePhoto Key="@photo" Alt="@Entry.Name" Sizes="@SitePhotos.CardSizes" />
    }
    else
    {
        <div class="image-placeholder" aria-hidden="true">@SiteText.Initial(Entry.Name)</div>
    }
    <div class="catalog-card-body">
        <h3><a href="@href">@Entry.Name</a></h3>
        @if (Unavailable)
        {
            <p class="badge badge-busy">@L["NotFreeOnDate"]</p>
        }
        @if (Entry.Description is not null)
        {
            <p>@Entry.Description</p>
        }
        @if (Entry.Contents.Count > 0)
        {
            <p class="muted">@L["BundleContains"]: @string.Join(", ", Entry.Contents)</p>
        }
        @* De prijs met de actie die geldt: de gewone prijs doorstreept en het label. *@
        <p class="price">
            @if (price.Promotion is not null)
            {
                <s class="old-price">@SiteText.Money(price.Normal)</s>
            }
            @SiteText.Money(price.Price) <span class="muted">@(Chosen.Period is { } period ? ForDays(period.Days) : L["PerDay"].Value)</span>
            <PromotionLabel Promotion="price.Promotion" />
        </p>
        <a class="button" href="@href" aria-hidden="true" tabindex="-1">@L["MoreInfo"]</a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public CatalogEntry Entry { get; set; } = null!;
    [Parameter] public ChosenPeriod Chosen { get; set; } = ChosenPeriod.None;
    [Parameter] public bool Unavailable { get; set; }
    /// <summary>De prijsregels, voor de prijs met periodeprijzen en acties; zonder: de gewone prijs.</summary>
    [Parameter] public PriceQuoter? Quoter { get; set; }

    private string ForDays(int days) => days == 1 ? L["ForOneDay"] : L["ForDays", days];
}
