@* Eén pagina per categorie, op haar slug in de taal van de URL. SiteLanguage herkent de slug (ook in een andere taal,
   dan met een 301) en zet de categorie in Links.Current; een ander woord is een 404. *@
@page "/{CategorySlug}"
@inject ICatalogService Catalog
@inject IReservationService Reservations
@inject IStringLocalizer<SharedResource> L
@inject SiteLinks Links
@inject IWebsiteTexts Texts
@inject NavigationManager Navigation
@inject TimeProvider Clock

@if (_category is null || _entries is null)
{
    <PageTitle>404</PageTitle>
    <p>404</p>
    return;
}

<PageTitle>@_category.Name</PageTitle>
<SiteHead Description="@Description" NoIndex="_chosen.InUrl" />

<div class="page">
    <p class="back"><a href="@(Links.Href(SiteRoute.Home) + _chosen.Query + "#aanbod")">← @L["Back"]</a></p>
    <h1>@_category.Name</h1>
    @foreach (var paragraph in SiteText.Paragraphs(_category.Intro))
    {
        <p class="intro">@paragraph</p>
    }

    <PeriodForm Action="@(Links.Href(_category.Route) + "#aanbod")" Chosen="_chosen" Today="_today" />

    <section id="aanbod" class="offer" aria-label="@_category.Name">
        @if (_chosen.Period is { } period)
        {
            <h2>@L["OfferFor", SiteText.Period(period)]</h2>
            <p class="muted">@L["AvailableCount", _entries.Count(e => !_unavailable.Contains(e.Id)), _entries.Count]</p>
        }
        else
        {
            <h2>@L["Catalog"]</h2>
        }
        <CatalogList Entries="_entries" Chosen="_chosen" Unavailable="_unavailable" />
    </section>
</div>

@code {
    [Parameter] public string CategorySlug { get; set; } = "";
    [SupplyParameterFromQuery(Name = ChosenPeriod.StartKey)] private string? Start { get; set; }
    [SupplyParameterFromQuery(Name = ChosenPeriod.EndKey)] private string? End { get; set; }

    private CategoryLink? _category;
    private IReadOnlyList<CatalogEntry>? _entries;
    private ChosenPeriod _chosen = ChosenPeriod.None;
    private DateOnly _today;
    private IReadOnlySet<Guid> _unavailable = new HashSet<Guid>();

    /// <summary>De eerste zin of zo van de inleiding, anders de naam.</summary>
    private string Description =>
        _category!.Intro.Length == 0 ? _category.Name
        : _category.Intro.Length <= 160 ? _category.Intro.ReplaceLineEndings(" ")
        : _category.Intro.ReplaceLineEndings(" ")[..157].TrimEnd() + "…";

    protected override async Task OnInitializedAsync()
    {
        if (Links.Current is not CategoryRoute route)
        {
            Navigation.NotFound();
            return;
        }
        _category = (await CategoryLink.AllAsync(Texts, Links)).FirstOrDefault(c => c.Id == route.CategoryId);
        if (_category is null)
        {
            Navigation.NotFound();
            return;
        }

        _today = ChosenPeriod.Today(Clock);
        _chosen = ChosenPeriod.From(Start, End, _today);
        _entries = (await Catalog.GetCatalogAsync(Links.Culture)).Where(e => e.CategoryId == _category.Id).ToList();
        if (_chosen.Period is { } period)
            _unavailable = await Reservations.FindUnavailableAsync(period);
    }
}
