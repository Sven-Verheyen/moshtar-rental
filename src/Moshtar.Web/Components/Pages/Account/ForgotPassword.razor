@page "/admin/wachtwoord-vergeten"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@inject PasswordRecovery Recovery
@inject NavigationManager Navigation

<PageTitle>Wachtwoord vergeten</PageTitle>

<h1>Wachtwoord vergeten</h1>

@if (_sent)
{
    <p role="status">Als dit e-mailadres bij ons gekend is, krijg je zo een mail met een link om een nieuw wachtwoord te kiezen. De link is 48 uur geldig.</p>
    <p><a href="admin/inloggen">Terug naar inloggen</a></p>
}
else
{
    <p>Vul je e-mailadres in. Je krijgt een mail met een link om een nieuw wachtwoord te kiezen.</p>

    <EditForm Model="Input" FormName="wachtwoord-vergeten" OnValidSubmit="RequestAsync" method="post">
        <DataAnnotationsValidator />
        <label>
            E-mailadres
            <InputText @bind-Value="Input!.Email" type="email" autocomplete="username" />
            <ValidationMessage For="() => Input!.Email" />
        </label>
        <button type="submit">Stuur mij een link</button>
    </EditForm>
    <p><a href="admin/inloggen">Terug naar inloggen</a></p>
}

@code {
    private bool _sent;

    [SupplyParameterFromForm(FormName = "wachtwoord-vergeten")] private ForgotInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task RequestAsync()
    {
        await Recovery.RequestAsync(Input!.Email, new Uri(Navigation.BaseUri));
        _sent = true;
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Vul je e-mailadres in.")]
        public string Email { get; set; } = "";
    }
}
