@page "/admin/wachtwoord-herstellen"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@inject PasswordRecovery Recovery
@inject NavigationManager Navigation

<PageTitle>Nieuw wachtwoord</PageTitle>

<h1>Nieuw wachtwoord</h1>

@if (_error is not null)
{
    <p class="account-error" role="alert">@_error</p>
}

<p>Kies een nieuw wachtwoord van minstens 12 tekens.</p>

<EditForm Model="Input" FormName="wachtwoord-herstellen" OnValidSubmit="ResetAsync" method="post">
    <DataAnnotationsValidator />
    <label>
        Nieuw wachtwoord
        <InputText @bind-Value="Input!.Password" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.Password" />
    </label>
    <label>
        Herhaal je wachtwoord
        <InputText @bind-Value="Input!.ConfirmPassword" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.ConfirmPassword" />
    </label>
    <button type="submit">Opslaan</button>
</EditForm>

@code {
    private string? _error;

    [SupplyParameterFromForm(FormName = "wachtwoord-herstellen")] private ResetInput? Input { get; set; }
    [SupplyParameterFromQuery(Name = "gebruiker")] private Guid UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? Code { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        _error = await Recovery.ResetAsync(UserId, Code, Input!.Password);
        if (_error is null)
            Navigation.NavigateTo("/admin/inloggen?hersteld=1");
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Kies een wachtwoord.")]
        [MinLength(12, ErrorMessage = "Een wachtwoord moet minstens 12 tekens lang zijn.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "De twee wachtwoorden zijn niet gelijk.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
