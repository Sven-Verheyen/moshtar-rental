@* Eén slug in alle talen, met het padwoord van de taal (ADR 0004); SiteLanguage stuurt een verkeerd padwoord door. *@
@page "/huren/{Slug}"
@page "/louer/{Slug}"
@page "/rent/{Slug}"
@inject ICatalogService Catalog
@inject IReservationService Reservations
@inject IStringLocalizer<SharedResource> L
@inject SiteLinks Links
@inject IWebsiteTexts Texts
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject ITenantContext TenantContext
@inject IImageStore Images
@inject IPriceQuotes Prices
@inject ICartService Carts

@if (_entry is null)
{
    <PageTitle>404</PageTitle>
    <p>404</p>
    return;
}

<SiteHead Title="@_entry.Name" Description="@(_entry.Description ?? _entry.Name)" Image="@(_entry.MainPhoto is { } photo ? Images.ShareUrl(photo) : null)"
          OgType="product" NoIndex="_chosen.InUrl" JsonLd="@([StructuredData.Product(_entry, Links, Images, ChosenPrice, DayPrice.Price), Breadcrumbs])" />

<div class="page">
<p class="back"><a href="@BackHref">← @BackText</a></p>
<h1>@_entry.Name</h1>

<div class="detail">
    <section class="detail-info">
        @if (_entry.Photos.Count == 0)
        {
            <div class="image-placeholder" aria-hidden="true">@SiteText.Initial(_entry.Name)</div>
        }
        else
        {
            <div class="gallery">
                @foreach (var (key, index) in _entry.Photos.Select((k, i) => (k, i)))
                {
                    <SitePhoto Key="@key" Alt="@(index == 0 ? _entry.Name : $"{_entry.Name} · {L["Photo", index + 1, _entry.Photos.Count]}")"
                               Sizes="@(index == 0 ? SitePhotos.MainSizes : SitePhotos.ThumbnailSizes)" Eager="index == 0" />
                }
            </div>
        }
        @if (_entry.Description is not null)
        {
            @foreach (var paragraph in SiteText.Paragraphs(_entry.Description))
            {
                <p>@paragraph</p>
            }
        }
        @if (_entry.Contents.Count > 0)
        {
            <p>@L["BundleContains"]: @string.Join(", ", _entry.Contents)</p>
        }
        @if (_entry.Specs is { } specs)
        {
            <h2>@L["Specs"]</h2>
            <dl class="specs">
                @if (specs.HasDimensions)
                {
                    <dt>@L["Dimensions"]</dt>
                    <dd>@Dimensions(specs)</dd>
                }
                @if (specs.MinAge is not null || specs.MaxAge is not null)
                {
                    <dt>@L["Age"]</dt>
                    <dd>@Ages(specs)</dd>
                }
                @if (specs.MaxPersons is { } persons)
                {
                    <dt>@L["MaxPersons"]</dt>
                    <dd>@persons</dd>
                }
                <dt>@L["RequiresPower"]</dt>
                <dd>@(specs.RequiresPower ? L["Yes"] : L["No"])</dd>
            </dl>
        }
        @if (_chosen.Period is { } chosenPeriod)
        {
            @* Met een gekozen datum de prijs voor die huurperiode (periodeprijzen en de actie die dan geldt), ook als het
               niet vrij is. Met een actie de gewone prijs doorstreept en het label. *@
            var price = PeriodPrice(chosenPeriod);
            <p class="price price-large">@L["Total"]: @if (price.Promotion is not null)
                {
                    <s class="old-price">@SiteText.Money(price.Normal)</s>@(" ")
                }@SiteText.Money(price.Price) <span class="muted">@ForDays(chosenPeriod.Days), @L["PerPiece"]</span><PromotionLabel Promotion="price.Promotion" /></p>
        }
        else
        {
            @* Zonder datum de dagprijs en de prijs per extra dag, met een actie die niet aan huurperiodes gebonden is:
               oude prijs doorstreept en label. *@
            <p class="price price-large">
                @if (DayPrice.Promotion is not null)
                {
                    <s class="old-price">@SiteText.Money(DayPrice.Normal)</s>
                }
                @SiteText.Money(DayPrice.Price) <span class="muted">@L["PerDay"]</span>
                <PromotionLabel Promotion="DayPrice.Promotion" />
                @if (ExtraDayPrice is { } extra)
                {
                    <span class="muted"> · @if (extra.Promotion is not null)
                        {
                            <s class="old-price">@SiteText.Money(extra.Normal)</s>@(" ")
                        }@SiteText.Money(extra.Price) @L["PerExtraDay"]</span>
                }
            </p>
        }
        @* De combinatiekortingen waarin dit artikel of pakket valt, om er een tweede bij te nemen. *@
        @foreach (var combo in _combos)
        {
            <p class="combo-hint">@L["ComboHint", combo]</p>
        }
    </section>

    <section id="reserveren" class="reservation">
        <h2>@L["ReserveThis"]</h2>

        @if (_chosen.Period is not { } period)
        {
            <p>@L["ChooseDateFirst"]</p>
            <PeriodForm Action="@(Here + "#reserveren")" Chosen="_chosen" Today="_today" />
        }
        else if (!_available)
        {
            <AnalyticsEvent Name="check_availability" Data="@AvailabilityChecked(period)" />
            <div class="availability busy" role="status">
                <p><strong>@L["NotAvailableOn", SiteText.Period(period)]</strong></p>
                <p>@L["NotAvailableExplanation"]</p>
            </div>
            <p class="actions">
                <a class="button" href="@(Here + "#reserveren")">@L["OtherDate"]</a>
                <a href="@(Links.Href(SiteRoute.Home) + _chosen.Query + "#aanbod")">@L["SeeWhatsFree"]</a>
            </p>
        }
        else
        {
            <AnalyticsEvent Name="check_availability" Data="@AvailabilityChecked(period)" />
            <div class="availability free" role="status">
                <p><strong>@L["AvailableOn", SiteText.Period(period)]</strong></p>
                <p><a href="@(Here + "#reserveren")">@L["OtherDate"]</a></p>
            </div>
            @if (CartResult == CartEndpoints.Added)
            {
                <AnalyticsEvent Name="add_to_cart" Data="@AddedToCart(period)" />
                <div class="alert success cart-added" role="status">
                    <p>@L["AddedToCart"]</p>
                    <a class="button" href="@Links.Href(SiteRoute.Cart)">@L["ToCart"]</a>
                </div>
            }
            else if (CartResult == CartEndpoints.NotAdded)
            {
                <p class="alert error" role="alert">@L["NotAddedToCart"]</p>
            }
            @* In de winkelkar, voor deze huurperiode. Een gewoon formulier: de winkelkar wijzigt op de server. *@
            <form class="add-to-cart" method="post" action="@CartEndpoints.AddPath">
                <AntiforgeryToken />
                <input type="hidden" name="terug" value="@(Here + _chosen.Query)" />
                <input type="hidden" name="soort" value="@(_entry.Kind == CatalogEntryKind.Item ? CartEndpoints.Item : CartEndpoints.Bundle)" />
                <input type="hidden" name="id" value="@_entry.Id" />
                <input type="hidden" name="@ChosenPeriod.StartKey" value="@ChosenPeriod.Format(period.Start)" />
                <input type="hidden" name="@ChosenPeriod.EndKey" value="@ChosenPeriod.Format(period.End)" />
                <label>@L["Quantity"] <input type="number" name="aantal" value="1" min="1" max="@Cart.MaxQuantity" /></label>
                <button type="submit" class="button button-large">@L["AddToCart"]</button>
            </form>
        }
    </section>
</div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = ChosenPeriod.StartKey)] private string? Start { get; set; }
    [SupplyParameterFromQuery(Name = ChosenPeriod.EndKey)] private string? End { get; set; }
    [SupplyParameterFromQuery(Name = CartEndpoints.ResultKey)] private string? CartResult { get; set; }
    [SupplyParameterFromQuery(Name = CartEndpoints.AddedQuantityKey)] private int? AddedQuantity { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private CatalogEntry? _entry;
    private CategoryLink? _category;
    private ChosenPeriod _chosen = ChosenPeriod.None;
    private DateOnly _today;
    private bool _available;
    private IReadOnlyList<string> _combos = [];
    private PriceQuoter? _quoter;
    // Alleen net na "In winkelkar": de winkelkar met wat er net in ging, voor de waarde van add_to_cart.
    private CartView? _cart;

    private static string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>Deze pagina zonder huurperiode, om een andere datum te kiezen.</summary>
    private string Here => Links.Href(new RentalRoute(Slug));

    /// <summary>Terug naar de categorie van het artikel, of naar het aanbod op de home; met de gekozen huurperiode.</summary>
    private string BackHref => _category is null
        ? Links.Href(SiteRoute.Home) + _chosen.Query + "#aanbod"
        : Links.Href(_category.Route) + _chosen.Query + "#aanbod";

    /// <summary>Het kruimelpad: home, de categorie als het artikel er een heeft, en het artikel.</summary>
    private System.Text.Json.Nodes.JsonObject Breadcrumbs => StructuredData.Breadcrumbs(
        new[] { (TenantContext.Tenant?.Name ?? "", Links.Absolute(SiteRoute.Home, Links.Culture)) }
            .Concat(_category is null ? [] : [(_category.Name, Links.Absolute(_category.Route, Links.Culture))])
            .Append((_entry!.Name, Links.Absolute(new RentalRoute(_entry.Slug), Links.Culture)))
            .ToArray());

    private string BackText => _category is null ? L["Back"] : L["BackTo", _category.Name];

    protected override async Task OnInitializedAsync()
    {
        _entry = await Catalog.GetBySlugAsync(Slug, Culture);
        // Een echte 404, zodat zoekmachines een onbestaand artikel niet indexeren.
        if (_entry is null)
        {
            Navigation.NotFound();
            return;
        }
        if (_entry.CategoryId is { } categoryId)
            _category = (await CategoryLink.AllAsync(Texts, Links)).FirstOrDefault(c => c.Id == categoryId);

        var fallback = TenantContext.Tenant?.DefaultCulture ?? Culture;
        _quoter = await Prices.CurrentAsync();
        _combos = _quoter.CombosFor(_entry).Select(r => r.NameIn(Culture, fallback)).Where(n => n.Length > 0).ToList();

        _today = ChosenPeriod.Today(Clock);
        _chosen = ChosenPeriod.From(Start, End, _today);
        if (_chosen.Period is { } period)
        {
            _available = (await Reservations.CheckAvailabilityAsync(period, [Line(1)])).Count == 0;
        }
        if (CartResult == CartEndpoints.Added)
            _cart = await Carts.GetAsync(CartEndpoints.Key(HttpContext), Culture);
    }

    private ReservationLineRequest Line(int quantity) => _entry!.Kind == CatalogEntryKind.Item
        ? new ReservationLineRequest(_entry.Id, null, quantity)
        : new ReservationLineRequest(null, _entry.Id, quantity);

    /// <summary>Voor Google Analytics: welk artikel voor welke periode, en of het vrij was. Geen persoonsgegevens.</summary>
    private System.Text.Json.Nodes.JsonObject AvailabilityChecked(Moshtar.Domain.Common.DateRange period) => new()
    {
        ["item_id"] = _entry!.Slug,
        ["item_name"] = _entry.Name,
        ["start_date"] = ChosenPeriod.Format(period.Start),
        ["end_date"] = ChosenPeriod.Format(period.End),
        ["days"] = period.Days,
        ["available"] = _available,
    };

    /// <summary>
    /// Voor Google Analytics: wat net in de winkelkar ging. De waarde is hoeveel het totaal van de winkelkar steeg, met
    /// de combinatiekortingen die de nieuwe stuks samen met wat er al in zat maken; de prijs per stuk is die waarde
    /// gedeeld door het aantal, op de cent. Geen persoonsgegevens.
    /// </summary>
    private System.Text.Json.Nodes.JsonObject AddedToCart(Moshtar.Domain.Common.DateRange period)
    {
        var quantity = Math.Clamp(AddedQuantity ?? 1, 1, Cart.MaxQuantity);
        var value = AddedValue(period, quantity);
        var price = Math.Round(value / quantity, 2, MidpointRounding.AwayFromZero);
        return AnalyticsItems.Event(value, [AnalyticsItems.Item(_entry!.Slug, _entry.Name, quantity, price)]);
    }

    /// <summary>
    /// Het totaal van de winkelkar erna min het totaal ervoor (zonder de stuks die er net bij kwamen), met dezelfde
    /// berekening als de winkelkar. Zonder winkelkar telt alleen wat er net in ging.
    /// </summary>
    private decimal AddedValue(Moshtar.Domain.Common.DateRange period, int quantity)
    {
        var here = _entry!.Ref();
        var after = (_cart?.Lines ?? []).Where(l => l.Entry is not null).Select(l => (Entry: l.Entry!, l.Quantity)).ToList();
        if (!after.Any(l => l.Entry.Ref() == here)) after.Add((_entry, quantity));
        var before = after.Select(l => l.Entry.Ref() == here ? l with { Quantity = l.Quantity - quantity } : l).Where(l => l.Quantity > 0);
        var cartPeriod = _cart?.Period ?? period;
        return CartTotal(cartPeriod, after) - CartTotal(cartPeriod, before);
    }

    private decimal CartTotal(Moshtar.Domain.Common.DateRange period, IEnumerable<(CatalogEntry Entry, int Quantity)> lines) =>
        _quoter!.Quote(period, lines.Select(l => l.Entry.ToPriceLine(l.Quantity)).ToList()).Total;

    /// <summary>Wat één stuk kost voor deze huurperiode: met periodeprijzen en de actie die geldt.</summary>
    private decimal PriceFor(Moshtar.Domain.Common.DateRange period) => PeriodPrice(period).Price;

    private SitePrice PeriodPrice(Moshtar.Domain.Common.DateRange period) =>
        _quoter?.SitePriceFor(_entry!, period) ?? new SitePrice(_entry!.PriceFor(period.Days), _entry.PriceFor(period.Days), null);

    /// <summary>Zonder datum: de dagprijs, met een actie die niet aan huurperiodes gebonden is.</summary>
    private SitePrice DayPrice => _quoter?.SitePriceFor(_entry!, null) ?? new SitePrice(_entry!.DayPrice, _entry.DayPrice, null);

    /// <summary>Zonder datum: de prijs per extra dag, met dezelfde actie als de dagprijs; null zonder prijs per extra dag.</summary>
    private SitePrice? ExtraDayPrice => _quoter is not null ? _quoter.ExtraDaySitePriceFor(_entry!)
        : _entry!.ExtraDayPrice is { } extra ? new SitePrice(extra, extra, null) : null;

    /// <summary>Met een gekozen huurperiode de prijs die de bezoeker ziet, ook voor de structured data; anders null (dagprijs).</summary>
    private StructuredData.PeriodPrice? ChosenPrice => _chosen.Period is { } period ? new(period.Days, PriceFor(period)) : null;

    private string ForDays(int days) => days == 1 ? L["ForOneDay"] : L["ForDays", days];

    private string Dimensions(ItemSpecs specs) =>
        string.Join(" × ", new[] { specs.LengthCm, specs.WidthCm, specs.HeightCm }.OfType<int>().Select(cm => (cm / 100m).ToString("0.##", CultureInfo.CurrentUICulture))) + " m";

    private string Ages(ItemSpecs specs) => (specs.MinAge, specs.MaxAge) switch
    {
        ({ } min, { } max) => $"{min} – {max} {L["Years"]}",
        ({ } min, null) => $"{min}+ {L["Years"]}",
        (null, { } max) => $"≤ {max} {L["Years"]}",
        _ => "",
    };
}
