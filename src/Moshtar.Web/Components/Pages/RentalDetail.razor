@* Eén slug in alle talen, met het padwoord van de taal (ADR 0004); SiteLanguage stuurt een verkeerd padwoord door. *@
@page "/huren/{Slug}"
@page "/louer/{Slug}"
@page "/rent/{Slug}"
@inject ICatalogService Catalog
@inject IReservationService Reservations
@inject IStringLocalizer<SharedResource> L
@inject SiteLinks Links
@inject NavigationManager Navigation

@if (_entry is null)
{
    <PageTitle>404</PageTitle>
    <p>404</p>
    return;
}

<PageTitle>@_entry.Name</PageTitle>
<SiteHead Description="@(_entry.Description ?? _entry.Name)" />

<div class="page">
<p class="back"><a href="@(Links.Href(SiteRoute.Home) + "#aanbod")">← @L["Back"]</a></p>
<h1>@_entry.Name</h1>

<div class="detail">
    <section class="detail-info">
        @if (_entry.ImageUrl is not null)
        {
            <img src="@_entry.ImageUrl" alt="@_entry.Name" width="960" height="720" />
        }
        else
        {
            <div class="image-placeholder" aria-hidden="true">@_entry.Name[..1]</div>
        }
        @if (_entry.Description is not null)
        {
            <p>@_entry.Description</p>
        }
        @if (_entry.Contents.Count > 0)
        {
            <p>@L["BundleContains"]: @string.Join(", ", _entry.Contents)</p>
        }
        <p class="price price-large">
            @_entry.DayPrice.ToString("C", Money) <span class="muted">@L["PerDay"]</span>
            @if (_entry.ExtraDayPrice is { } extra)
            {
                <span class="muted"> · @extra.ToString("C", Money) @L["PerExtraDay"]</span>
            }
        </p>
    </section>

    <section id="reserveren" class="reservation">
        <h2>@L["ReserveThis"]</h2>

        @if (_confirmation is not null)
        {
            <p class="alert success">@_confirmation</p>
        }
        else
        {
            @if (_error is not null)
            {
                <p class="alert error">@_error</p>
            }
            <EditForm Model="Form" FormName="reservation" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <label>@L["StartDate"] <InputDate @bind-Value="Form!.StartDate" min="@Today" /></label>
                    <label>@L["EndDate"] <InputDate @bind-Value="Form!.EndDate" min="@Today" /></label>
                    <label>@L["Quantity"] <InputNumber @bind-Value="Form!.Quantity" min="1" /></label>
                </div>
                <div class="row">
                    <label>@L["FirstName"] <InputText @bind-Value="Form!.FirstName" autocomplete="given-name" /></label>
                    <label>@L["LastName"] <InputText @bind-Value="Form!.LastName" autocomplete="family-name" /></label>
                </div>
                <div class="row">
                    <label>@L["Email"] <InputText type="email" @bind-Value="Form!.Email" autocomplete="email" /></label>
                    <label>@L["Phone"] <InputText type="tel" @bind-Value="Form!.Phone" autocomplete="tel" /></label>
                </div>
                <label>@L["Street"] <InputText @bind-Value="Form!.Street" autocomplete="street-address" /></label>
                <div class="row">
                    <label>@L["PostalCode"] <InputText @bind-Value="Form!.PostalCode" autocomplete="postal-code" /></label>
                    <label>@L["City"] <InputText @bind-Value="Form!.City" autocomplete="address-level2" /></label>
                </div>
                <fieldset>
                    <legend>@L["DeliveryMethod"]</legend>
                    <InputRadioGroup @bind-Value="Form!.DeliveryMethod">
                        <label><InputRadio Value="DeliveryMethod.Delivery" /> @L["Delivery"]</label>
                        <label><InputRadio Value="DeliveryMethod.Pickup" /> @L["Pickup"]</label>
                    </InputRadioGroup>
                </fieldset>
                <label>@L["Notes"] <InputTextArea @bind-Value="Form!.Notes" rows="3" /></label>
                <button type="submit" class="button button-large">@L["Submit"]</button>
            </EditForm>
        }
    </section>
</div>
</div>

@code {
    private static readonly CultureInfo Money = CultureInfo.GetCultureInfo("nl-BE");

    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromForm] private ReservationForm? Form { get; set; }

    private CatalogEntry? _entry;
    private string? _confirmation;
    private string? _error;

    private static string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private static string Today => DateTime.Today.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        Form ??= new();
        _entry = await Catalog.GetBySlugAsync(Slug, Culture);
        // Een echte 404, zodat zoekmachines een onbestaand artikel niet indexeren.
        if (_entry is null) Navigation.NotFound();
    }

    private async Task SubmitAsync()
    {
        if (_entry is null || Form is null) return;
        if (Form.EndDate < Form.StartDate)
        {
            _error = L["EndDate"] + " < " + L["StartDate"];
            return;
        }

        var address = new Moshtar.Domain.Common.Address { Street = Form.Street, PostalCode = Form.PostalCode, City = Form.City };
        var line = _entry.Kind == CatalogEntryKind.Item
            ? new ReservationLineRequest(_entry.Id, null, Form.Quantity)
            : new ReservationLineRequest(null, _entry.Id, Form.Quantity);

        try
        {
            var result = await Reservations.ReserveAsync(new ReservationRequest(
                new Moshtar.Domain.Common.DateRange(Form.StartDate!.Value, Form.EndDate!.Value),
                [line],
                new ReservationCustomer(Form.FirstName, Form.LastName, Form.Email, Form.Phone, address),
                Form.DeliveryMethod,
                address,
                Form.Notes,
                Culture),
                ReservationActor.Website);

            if (result.Reservation is { } reservation)
                _confirmation = L["Confirmed", reservation.Number, reservation.TotalPrice.ToString("C", Money)];
            else
                _error = L["NotAvailable", result.Shortages[0].Day.ToString("d", CultureInfo.CurrentUICulture)];
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }
}
