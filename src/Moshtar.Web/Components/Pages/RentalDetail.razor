@* Eén slug in alle talen, met het padwoord van de taal (ADR 0004); SiteLanguage stuurt een verkeerd padwoord door. *@
@page "/huren/{Slug}"
@page "/louer/{Slug}"
@page "/rent/{Slug}"
@inject ICatalogService Catalog
@inject IReservationService Reservations
@inject IStringLocalizer<SharedResource> L
@inject SiteLinks Links
@inject IWebsiteTexts Texts
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject ITenantContext TenantContext

@if (_entry is null)
{
    <PageTitle>404</PageTitle>
    <p>404</p>
    return;
}

<SiteHead Title="@_entry.Name" Description="@(_entry.Description ?? _entry.Name)" Image="@_entry.ImageUrl" OgType="product"
          NoIndex="_chosen.InUrl" JsonLd="@([StructuredData.Product(_entry, Links), Breadcrumbs])" />

<div class="page">
<p class="back"><a href="@BackHref">← @BackText</a></p>
<h1>@_entry.Name</h1>

<div class="detail">
    <section class="detail-info">
        @if (_entry.Images.Count == 0)
        {
            <div class="image-placeholder" aria-hidden="true">@SiteText.Initial(_entry.Name)</div>
        }
        else
        {
            <div class="gallery">
                @foreach (var (url, index) in _entry.Images.Select((u, i) => (u, i)))
                {
                    <img src="@url" alt="@(index == 0 ? _entry.Name : $"{_entry.Name} · {L["Photo", index + 1, _entry.Images.Count]}")"
                         width="960" height="720" loading="@(index == 0 ? "eager" : "lazy")" />
                }
            </div>
        }
        @if (_entry.Description is not null)
        {
            @foreach (var paragraph in SiteText.Paragraphs(_entry.Description))
            {
                <p>@paragraph</p>
            }
        }
        @if (_entry.Contents.Count > 0)
        {
            <p>@L["BundleContains"]: @string.Join(", ", _entry.Contents)</p>
        }
        @if (_entry.Specs is { } specs)
        {
            <h2>@L["Specs"]</h2>
            <dl class="specs">
                @if (specs.HasDimensions)
                {
                    <dt>@L["Dimensions"]</dt>
                    <dd>@Dimensions(specs)</dd>
                }
                @if (specs.MinAge is not null || specs.MaxAge is not null)
                {
                    <dt>@L["Age"]</dt>
                    <dd>@Ages(specs)</dd>
                }
                @if (specs.MaxPersons is { } persons)
                {
                    <dt>@L["MaxPersons"]</dt>
                    <dd>@persons</dd>
                }
                <dt>@L["RequiresPower"]</dt>
                <dd>@(specs.RequiresPower ? L["Yes"] : L["No"])</dd>
            </dl>
        }
        <p class="price price-large">
            @SiteText.Money(_entry.DayPrice) <span class="muted">@L["PerDay"]</span>
            @if (_entry.ExtraDayPrice is { } extra)
            {
                <span class="muted"> · @SiteText.Money(extra) @L["PerExtraDay"]</span>
            }
        </p>
    </section>

    <section id="reserveren" class="reservation">
        <h2>@L["ReserveThis"]</h2>

        @if (_confirmation is not null)
        {
            <p class="alert success" role="status">@_confirmation</p>
        }
        else if (_chosen.Period is not { } period)
        {
            <p>@L["ChooseDateFirst"]</p>
            <PeriodForm Action="@(Here + "#reserveren")" Chosen="_chosen" Today="_today" />
        }
        else if (!_available)
        {
            <div class="availability busy" role="status">
                <p><strong>@L["NotAvailableOn", SiteText.Period(period)]</strong></p>
                <p>@L["NotAvailableExplanation"]</p>
            </div>
            <p class="actions">
                <a class="button" href="@(Here + "#reserveren")">@L["OtherDate"]</a>
                <a href="@(Links.Href(SiteRoute.Home) + _chosen.Query + "#aanbod")">@L["SeeWhatsFree"]</a>
            </p>
        }
        else
        {
            <div class="availability free" role="status">
                <p><strong>@L["AvailableOn", SiteText.Period(period)]</strong></p>
                <p class="price price-large">@L["Total"]: @SiteText.Money(_entry.PriceFor(period.Days)) <span class="muted">@ForDays(period.Days), @L["PerPiece"]</span></p>
                <p><a href="@(Here + "#reserveren")">@L["OtherDate"]</a></p>
            </div>
            @if (_error is not null)
            {
                <p class="alert error" role="alert">@_error</p>
            }
            <EditForm Model="Form" FormName="reservation" OnValidSubmit="SubmitAsync" action="#reserveren">
                <DataAnnotationsValidator />
                <ValidationSummary />
                @* De huurperiode is gekozen en getoond hierboven; een andere datum kiest de klant met de link. *@
                <input type="hidden" name="Form.StartDate" value="@ChosenPeriod.Format(Form!.StartDate)" />
                <input type="hidden" name="Form.EndDate" value="@ChosenPeriod.Format(Form!.EndDate)" />
                <div class="row">
                    <label>@L["Quantity"] <InputNumber @bind-Value="Form!.Quantity" min="1" /></label>
                </div>
                <div class="row">
                    <label>@L["FirstName"] <InputText @bind-Value="Form!.FirstName" autocomplete="given-name" /></label>
                    <label>@L["LastName"] <InputText @bind-Value="Form!.LastName" autocomplete="family-name" /></label>
                </div>
                <div class="row">
                    <label>@L["Email"] <InputText type="email" @bind-Value="Form!.Email" autocomplete="email" /></label>
                    <label>@L["Phone"] <InputText type="tel" @bind-Value="Form!.Phone" autocomplete="tel" /></label>
                </div>
                <label>@L["Street"] <InputText @bind-Value="Form!.Street" autocomplete="street-address" /></label>
                <div class="row">
                    <label>@L["PostalCode"] <InputText @bind-Value="Form!.PostalCode" autocomplete="postal-code" /></label>
                    <label>@L["City"] <InputText @bind-Value="Form!.City" autocomplete="address-level2" /></label>
                </div>
                <fieldset>
                    <legend>@L["DeliveryMethod"]</legend>
                    <InputRadioGroup @bind-Value="Form!.DeliveryMethod">
                        <label><InputRadio Value="DeliveryMethod.Delivery" /> @L["Delivery"]</label>
                        <label><InputRadio Value="DeliveryMethod.Pickup" /> @L["Pickup"]</label>
                    </InputRadioGroup>
                </fieldset>
                <label>@L["Notes"] <InputTextArea @bind-Value="Form!.Notes" rows="3" /></label>
                <button type="submit" class="button button-large">@L["Submit"]</button>
            </EditForm>
        }
    </section>
</div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromForm] private ReservationForm? Form { get; set; }
    [SupplyParameterFromQuery(Name = ChosenPeriod.StartKey)] private string? Start { get; set; }
    [SupplyParameterFromQuery(Name = ChosenPeriod.EndKey)] private string? End { get; set; }

    private CatalogEntry? _entry;
    private CategoryLink? _category;
    private ChosenPeriod _chosen = ChosenPeriod.None;
    private DateOnly _today;
    private bool _available;
    private string? _confirmation;
    private string? _error;

    private static string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>Deze pagina zonder huurperiode, om een andere datum te kiezen.</summary>
    private string Here => Links.Href(new RentalRoute(Slug));

    /// <summary>Terug naar de categorie van het artikel, of naar het aanbod op de home; met de gekozen huurperiode.</summary>
    private string BackHref => _category is null
        ? Links.Href(SiteRoute.Home) + _chosen.Query + "#aanbod"
        : Links.Href(_category.Route) + _chosen.Query + "#aanbod";

    /// <summary>Het kruimelpad: home, de categorie als het artikel er een heeft, en het artikel.</summary>
    private System.Text.Json.Nodes.JsonObject Breadcrumbs => StructuredData.Breadcrumbs(
        new[] { (TenantContext.Tenant?.Name ?? "", Links.Absolute(SiteRoute.Home, Links.Culture)) }
            .Concat(_category is null ? [] : [(_category.Name, Links.Absolute(_category.Route, Links.Culture))])
            .Append((_entry!.Name, Links.Absolute(new RentalRoute(_entry.Slug), Links.Culture)))
            .ToArray());

    private string BackText => _category is null ? L["Back"] : L["BackTo", _category.Name];

    protected override async Task OnInitializedAsync()
    {
        _entry = await Catalog.GetBySlugAsync(Slug, Culture);
        // Een echte 404, zodat zoekmachines een onbestaand artikel niet indexeren.
        if (_entry is null)
        {
            Navigation.NotFound();
            return;
        }
        if (_entry.CategoryId is { } categoryId)
            _category = (await CategoryLink.AllAsync(Texts, Links)).FirstOrDefault(c => c.Id == categoryId);

        _today = ChosenPeriod.Today(Clock);
        _chosen = ChosenPeriod.From(Start, End, _today);
        Form ??= new() { StartDate = _chosen.Period?.Start, EndDate = _chosen.Period?.End };
        if (_chosen.Period is { } period)
            _available = (await Reservations.CheckAvailabilityAsync(period, [Line(1)])).Count == 0;
    }

    private ReservationLineRequest Line(int quantity) => _entry!.Kind == CatalogEntryKind.Item
        ? new ReservationLineRequest(_entry.Id, null, quantity)
        : new ReservationLineRequest(null, _entry.Id, quantity);

    private async Task SubmitAsync()
    {
        if (_entry is null || Form is null) return;
        if (Form.EndDate < Form.StartDate)
        {
            _error = L["PeriodEndBeforeStart"];
            return;
        }

        var address = new Moshtar.Domain.Common.Address { Street = Form.Street, PostalCode = Form.PostalCode, City = Form.City };
        try
        {
            var result = await Reservations.ReserveAsync(new ReservationRequest(
                new Moshtar.Domain.Common.DateRange(Form.StartDate!.Value, Form.EndDate!.Value),
                [Line(Form.Quantity)],
                new ReservationCustomer(Form.FirstName, Form.LastName, Form.Email, Form.Phone, address),
                Form.DeliveryMethod,
                address,
                Form.Notes,
                Culture),
                ReservationActor.Website);

            if (result.Reservation is { } reservation)
                _confirmation = L["Confirmed", reservation.Number, SiteText.Money(reservation.TotalPrice)];
            else
                _error = L["NotAvailable", result.Shortages[0].Day.ToString("d", CultureInfo.CurrentUICulture)];
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private string ForDays(int days) => days == 1 ? L["ForOneDay"] : L["ForDays", days];

    private string Dimensions(ItemSpecs specs) =>
        string.Join(" × ", new[] { specs.LengthCm, specs.WidthCm, specs.HeightCm }.OfType<int>().Select(cm => (cm / 100m).ToString("0.##", CultureInfo.CurrentUICulture))) + " m";

    private string Ages(ItemSpecs specs) => (specs.MinAge, specs.MaxAge) switch
    {
        ({ } min, { } max) => $"{min} – {max} {L["Years"]}",
        ({ } min, null) => $"{min}+ {L["Years"]}",
        (null, { } max) => $"≤ {max} {L["Years"]}",
        _ => "",
    };
}
