@page "/admin/prijsregels"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Administrator)]

<PageTitle>Prijsregels</PageTitle>

@* Alle prijsregels op één plaats, per soort een tabblad; ?tab=acties opent meteen de acties. Alleen het open tabblad
   wordt getekend: de editors delen één databankcontext en mogen niet tegelijk laden. *@
<AdminShell Title="Prijsregels">
    <MudTabs @bind-ActivePanelIndex="_tab" Elevation="1" Rounded="true" TabPanelsClass="pt-4">
        <MudTabPanel Text="Combinatiekortingen">
            <ComboDiscountsEditor />
        </MudTabPanel>
        <MudTabPanel Text="Periodeprijzen">
            @* Het tabblad Periodeprijzen (#92). *@
            <MudText Typo="Typo.body2">Periodeprijzen komen hier binnenkort.</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Acties">
            <PromotionsEditor />
        </MudTabPanel>
    </MudTabs>
    @* De rekentool komt hier, onder de tabbladen: dezelfde berekening als de website (PriceCalculator), zonder iets te bewaren. *@
</AdminShell>

@code {
    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }

    private int _tab;

    protected override void OnInitialized() => _tab = Tab switch
    {
        "acties" => 2,
        _ => 0,
    };
}
