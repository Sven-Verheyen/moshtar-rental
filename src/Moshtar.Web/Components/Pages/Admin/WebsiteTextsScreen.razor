@page "/admin/websiteteksten"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Administrator)]
@inject IWebsiteTextAdministration Texts
@inject ITenantContext TenantContext
@inject ISnackbar Snackbar

<PageTitle>Websiteteksten</PageTitle>

<AdminShell Title="Websiteteksten">
    <MudText Typo="Typo.body1" Class="mb-4">
        Pas de teksten van je reservatiewebsite aan, in elke taal die je aanbiedt. Zolang je niets aanpast, geldt de standaardtekst
        van Moshtar, met je naam en je werkgebied ingevuld. Naam, slug en inleiding van een categorie pas je aan bij
        <MudLink Href="admin/categorieen">Categorieën</MudLink>.
    </MudText>

    <MudTabs Elevation="1" Rounded="true" TabPanelsClass="pt-4">
        @foreach (var culture in Cultures)
        {
            <MudTabPanel Text="@LanguageName(culture)">
                @if (_texts.GetValueOrDefault(culture) is { } texts)
                {
                    var home = _home[culture];
                    <MudPaper Class="pa-4 mb-4" Elevation="1">
                        <MudText Typo="Typo.h6" Class="mb-2">Home</MudText>
                        <MudTextField @bind-Value="home.Title" Label="Titel" Variant="Variant.Outlined" Class="mb-1" />
                        <TextStatus Text="texts.HomeTitle" OnReset="() => ResetAsync(culture, WebsiteTextKey.HomeTitle)" />
                        <MudTextField @bind-Value="home.Subtitle" Label="Ondertitel" Variant="Variant.Outlined" Lines="2" Class="mb-1 mt-3" />
                        <TextStatus Text="texts.HomeSubtitle" OnReset="() => ResetAsync(culture, WebsiteTextKey.HomeSubtitle)" />
                        <Problems Items="@_problems.GetValueOrDefault((culture, "home"))" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="() => SaveHomeAsync(culture)">Opslaan</MudButton>
                    </MudPaper>

                    <MudPaper Class="pa-4 mb-4" Elevation="1">
                        <MudText Typo="Typo.h6" Class="mb-1">Veelgestelde vragen</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">@(texts.FaqIsCustomized ? "Aangepast." : "Standaardvragen van Moshtar.")</MudText>
                        @{ var faq = _faq[culture]; }
                        @for (var i = 0; i < faq.Count; i++)
                        {
                            var index = i;
                            var entry = faq[index];
                            <MudPaper Outlined="true" Class="pa-3 mb-3">
                                <MudStack Row="true" AlignItems="AlignItems.Start">
                                    <MudStack Class="flex-grow-1">
                                        <MudTextField @bind-Value="entry.Question" Label="@($"Vraag {index + 1}")" Variant="Variant.Outlined" />
                                        <MudTextField @bind-Value="entry.Answer" Label="Antwoord" Variant="Variant.Outlined" Lines="3" />
                                    </MudStack>
                                    <MudStack Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" aria-label="Naar boven" Disabled="index == 0" OnClick="() => Move(culture, index, -1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" aria-label="Naar beneden" Disabled="index == faq.Count - 1" OnClick="() => Move(culture, index, 1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Verwijderen" OnClick="() => faq.RemoveAt(index)" />
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => faq.Add(new FaqDraft())">Vraag toevoegen</MudButton>
                        <Problems Items="@_problems.GetValueOrDefault((culture, "faq"))" />
                        <MudStack Row="true" Class="mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveFaqAsync(culture)">Opslaan</MudButton>
                            <MudButton Variant="Variant.Outlined" Disabled="!texts.FaqIsCustomized" OnClick="() => ResetAsync(culture, WebsiteTextKey.Faq)">Terug naar standaard</MudButton>
                        </MudStack>
                    </MudPaper>
                }
            </MudTabPanel>
        }
    </MudTabs>
</AdminShell>

@code {
    private sealed class HomeDraft { public string Title { get; set; } = ""; public string Subtitle { get; set; } = ""; }
    private sealed class FaqDraft { public string Question { get; set; } = ""; public string Answer { get; set; } = ""; }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private readonly Dictionary<string, WebsiteTexts> _texts = [];
    private readonly Dictionary<string, HomeDraft> _home = [];
    private readonly Dictionary<string, List<FaqDraft>> _faq = [];
    private readonly Dictionary<(string, string), IReadOnlyList<string>> _problems = [];

    private IReadOnlyList<string> Cultures => TenantContext.Tenant?.Cultures ?? [];

    protected override async Task OnInitializedAsync()
    {
        foreach (var culture in Cultures) await LoadAsync(culture);
    }

    /// <summary>Laadt alle teksten en concepten van één taal.</summary>
    private async Task LoadAsync(string culture)
    {
        var texts = await RefreshAsync(culture);
        _home[culture] = new HomeDraft { Title = texts.HomeTitle.Value, Subtitle = texts.HomeSubtitle.Value };
        _faq[culture] = texts.Faq.Select(e => new FaqDraft { Question = e.Question, Answer = e.Answer }).ToList();
    }

    /// <summary>Laadt de teksten van één taal opnieuw, zonder de concepten aan te raken: wat elders nog niet bewaard is, blijft staan.</summary>
    private async Task<WebsiteTexts> RefreshAsync(string culture) => _texts[culture] = await Texts.GetAsync(culture);

    private Task SaveHomeAsync(string culture) =>
        CheckedAsync(culture, "home",
            userId => Texts.SaveHomeAsync(culture, _home[culture].Title ?? "", _home[culture].Subtitle ?? "", userId),
            texts => _home[culture] = new HomeDraft { Title = texts.HomeTitle.Value, Subtitle = texts.HomeSubtitle.Value });

    private Task SaveFaqAsync(string culture) =>
        CheckedAsync(culture, "faq",
            userId => Texts.SaveFaqAsync(culture, _faq[culture].Select(e => new FaqEntry(e.Question ?? "", e.Answer ?? "")).ToList(), userId),
            texts => _faq[culture] = texts.Faq.Select(e => new FaqDraft { Question = e.Question, Answer = e.Answer }).ToList());

    /// <summary>
    /// Bewaart één onderdeel en zet alleen het concept van dat onderdeel op wat bewaard is; toont de problemen bij het
    /// onderdeel als het niet in orde is.
    /// </summary>
    private async Task CheckedAsync(string culture, string section, Func<Guid, Task> save, Action<WebsiteTexts> refreshDraft)
    {
        try
        {
            await save((await AuthenticationState).User.Id());
            refreshDraft(await RefreshAsync(culture));
            _problems.Remove((culture, section));
            Snackbar.Add($"Bewaard in het {LanguageName(culture)}.", Severity.Success);
        }
        catch (WebsiteTextException e)
        {
            _problems[(culture, section)] = e.Problems;
        }
    }

    /// <summary>Zet één tekst terug naar de standaard; alleen dat veld in het concept verandert mee.</summary>
    private async Task ResetAsync(string culture, WebsiteTextKey key)
    {
        var section = key == WebsiteTextKey.Faq ? "faq" : "home";
        try
        {
            await Texts.ResetAsync(culture, key);
            var texts = await RefreshAsync(culture);
            switch (key)
            {
                case WebsiteTextKey.HomeTitle: _home[culture].Title = texts.HomeTitle.Value; break;
                case WebsiteTextKey.HomeSubtitle: _home[culture].Subtitle = texts.HomeSubtitle.Value; break;
                case WebsiteTextKey.Faq: _faq[culture] = texts.Faq.Select(e => new FaqDraft { Question = e.Question, Answer = e.Answer }).ToList(); break;
            }
            _problems.Remove((culture, section));
            Snackbar.Add($"De standaardtekst geldt weer in het {LanguageName(culture)}.", Severity.Success);
        }
        catch (WebsiteTextException e)
        {
            _problems[(culture, section)] = e.Problems;
        }
    }

    private void Move(string culture, int index, int offset)
    {
        var faq = _faq[culture];
        (faq[index], faq[index + offset]) = (faq[index + offset], faq[index]);
    }

    private static string LanguageName(string culture) => culture switch
    {
        "nl" => "Nederlands",
        "fr" => "Frans",
        "en" => "Engels",
        _ => culture,
    };
}
