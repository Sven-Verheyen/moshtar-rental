@page "/admin/mailsjablonen"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Administrator)]
@using Moshtar.Application.Mail
@using Moshtar.Domain.Mail
@inject IMailTemplateAdministration Templates
@inject ISnackbar Snackbar
@inject ILogger<MailTemplates> Logger
@inject IJSRuntime JS

<PageTitle>Mailsjablonen</PageTitle>

<AdminShell Title="Mailsjablonen">
    <MudText Typo="Typo.body1" Class="mb-4">
        Pas de mails aan die je klanten krijgen, in elke taal die je aanbiedt. Zolang je niets aanpast, geldt de standaardtekst van Moshtar.
    </MudText>

    @foreach (var kind in MailKinds.All)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@kind.Name</MudText>
            @if (_versions.GetValueOrDefault(kind.Kind) is { } versions)
            {
                <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-4">
                    @foreach (var version in versions)
                    {
                        var draft = _drafts[(kind.Kind, version.Culture)];
                        <MudTabPanel Text="@LanguageName(version.Culture)">
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @if (version.IsCustomized)
                                {
                                    <span>Aangepast door @(version.UpdatedByEmail ?? "een onbekende gebruiker") op @Local(version.UpdatedAtUtc!.Value).</span>
                                }
                                else
                                {
                                    <span>Standaardtekst van Moshtar.</span>
                                }
                            </MudText>
                            <MudTextField @bind-Value="draft.Subject" Label="Onderwerp" Variant="Variant.Outlined" Class="mb-3" />
                            <MudToolBar Dense="true" Gutters="false" Class="mb-1">
                                <MudTooltip Text="Vet">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatBold" aria-label="Vet" OnClick="@(() => WrapAsync(kind, version.Culture, "**", "**", "vette tekst"))" />
                                </MudTooltip>
                                <MudTooltip Text="Cursief">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" aria-label="Cursief" OnClick="@(() => WrapAsync(kind, version.Culture, "*", "*", "schuine tekst"))" />
                                </MudTooltip>
                                <MudTooltip Text="Link">
                                    <MudIconButton Icon="@Icons.Material.Filled.Link" aria-label="Link" OnClick="@(() => WrapAsync(kind, version.Culture, "[", "](https://)", "linktekst"))" />
                                </MudTooltip>
                            </MudToolBar>
                            <div id="@EditorId(kind.Kind, version.Culture)">
                                <MudTextField @bind-Value="draft.Body" Label="Tekst" Variant="Variant.Outlined" Lines="14"
                                              HelperText="Laat een lege regel tussen twee alinea's. **vet**, *cursief* en [tekst](https://adres) worden opmaak." />
                            </div>
                            <MudText Typo="Typo.body2" Class="mt-3 mb-1">Klik om een plaatshouder in te voegen:</MudText>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var placeholder in kind.Placeholders)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => InsertAsync(kind, version.Culture, "{" + placeholder + "}"))">{@placeholder}</MudChip>
                                }
                            </div>
                            @foreach (var block in kind.Blocks)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">{@block} voegt het vaste overzicht van de reservatie in en moet in de tekst staan.</MudText>
                            }
                            @if (_problems.GetValueOrDefault((kind.Kind, version.Culture)) is { Count: > 0 } problems)
                            {
                                <MudAlert Severity="Severity.Error" Class="mt-3">
                                    @foreach (var problem in problems)
                                    {
                                        <div>@problem</div>
                                    }
                                </MudAlert>
                            }
                            <MudStack Row="true" Class="mt-4" Wrap="Wrap.Wrap">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveAsync(kind, version.Culture)">Opslaan</MudButton>
                                <MudButton Variant="Variant.Outlined" Disabled="!version.IsCustomized" OnClick="() => ResetAsync(kind, version.Culture)">Terug naar standaard</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="() => PreviewAsync(kind, version.Culture)">Voorbeeld</MudButton>
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" OnClick="() => SendTestAsync(kind, version.Culture)">Stuur testmail naar mij</MudButton>
                            </MudStack>
                            @if (_previews.GetValueOrDefault((kind.Kind, version.Culture)) is { } preview)
                            {
                                <MudPaper Outlined="true" Class="pa-4 mt-4">
                                    <MudText Typo="Typo.overline">Voorbeeld met een fictieve reservatie</MudText>
                                    <MudText Typo="Typo.subtitle1" Class="mb-2"><strong>@preview.Subject</strong></MudText>
                                    <MudDivider Class="mb-2" />
                                    @* De HTML komt uit de mailopbouw, waar alle tekst ge-escaped wordt (ADR 0003). *@
                                    <div class="mail-preview">@((MarkupString)preview.HtmlBody)</div>
                                </MudPaper>
                            }
                        </MudTabPanel>
                    }
                </MudTabs>
            }
        </MudPaper>
    }
</AdminShell>

@code {
    private sealed class Draft
    {
        public string Subject { get; set; } = "";
        public string Body { get; set; } = "";
    }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private static readonly TimeZoneInfo BelgianTime = TimeZoneInfo.FindSystemTimeZoneById("Europe/Brussels");
    private readonly Dictionary<MailKind, IReadOnlyList<MailTemplateVersion>> _versions = [];
    private readonly Dictionary<(MailKind, string), Draft> _drafts = [];
    private readonly Dictionary<(MailKind, string), IReadOnlyList<string>> _problems = [];
    private readonly Dictionary<(MailKind, string), MailMessage> _previews = [];

    protected override async Task OnInitializedAsync()
    {
        foreach (var kind in MailKinds.All) await LoadAsync(kind.Kind, culture: null);
    }

    /// <summary>Laadt de versies opnieuw; het concept van <paramref name="culture"/> (of van alle talen) wordt overschreven.</summary>
    private async Task LoadAsync(MailKind kind, string? culture)
    {
        var versions = await Templates.GetAsync(kind);
        _versions[kind] = versions;
        foreach (var version in versions)
            if (culture is null || version.Culture == culture || !_drafts.ContainsKey((kind, version.Culture)))
                _drafts[(kind, version.Culture)] = new Draft { Subject = version.Text.Subject, Body = version.Text.Body };
    }

    private Task SaveAsync(MailKindDefinition kind, string culture) =>
        CheckedAsync(kind, culture, async text =>
        {
            await Templates.SaveAsync(kind.Kind, culture, text, await UserIdAsync());
            Snackbar.Add($"{kind.Name} in het {LanguageName(culture)} is bewaard.", Severity.Success);
            await LoadAsync(kind.Kind, culture);
        });

    private Task PreviewAsync(MailKindDefinition kind, string culture) =>
        CheckedAsync(kind, culture, async text => _previews[(kind.Kind, culture)] = await Templates.PreviewAsync(kind.Kind, culture, text));

    private Task SendTestAsync(MailKindDefinition kind, string culture) =>
        CheckedAsync(kind, culture, async text =>
        {
            try
            {
                await Templates.SendTestAsync(kind.Kind, culture, text, await UserIdAsync());
                Snackbar.Add("Testmail verstuurd naar je eigen adres.", Severity.Success);
            }
            catch (InvalidOperationException e)
            {
                // Onze eigen meldingen, bv. een verhuurder zonder afzenderadres.
                Snackbar.Add($"Testmail niet verstuurd: {e.Message}", Severity.Error);
            }
            catch (Exception e) when (e is not MailTemplateException)
            {
                // Een fout van de mailserver mag het scherm niet doen crashen, en hoort niet bij de beheerder.
                Logger.LogError(e, "Testmail voor {Kind} in {Culture} kon niet vertrekken.", kind.Kind, culture);
                Snackbar.Add("Testmail niet verstuurd: de mailserver gaf een fout. Probeer het later opnieuw.", Severity.Error);
            }
        });

    /// <summary>Voert een actie uit met de tekst uit het scherm, en toont de problemen als die niet in orde is.</summary>
    private async Task CheckedAsync(MailKindDefinition kind, string culture, Func<MailTemplateText, Task> action)
    {
        var draft = _drafts[(kind.Kind, culture)];
        try
        {
            await action(new MailTemplateText(draft.Subject ?? "", draft.Body ?? ""));
            _problems.Remove((kind.Kind, culture));
        }
        catch (MailTemplateException e)
        {
            _problems[(kind.Kind, culture)] = e.Problems;
            _previews.Remove((kind.Kind, culture));
        }
    }

    private IJSObjectReference? _editor;

    private static string EditorId(MailKind kind, string culture) => $"mailsjabloon-{kind}-{culture}";

    /// <summary>Zet opmaaktekens rond de selectie in de tekst, of rond een voorbeeldwoord als niets geselecteerd is.</summary>
    private Task WrapAsync(MailKindDefinition kind, string culture, string before, string after, string example) =>
        EditAsync(kind, culture, "wrap", before, after, example);

    /// <summary>Voegt tekst in op de cursor, in de plaats van de selectie.</summary>
    private Task InsertAsync(MailKindDefinition kind, string culture, string text) =>
        EditAsync(kind, culture, "insert", text, "", "");

    private async Task EditAsync(MailKindDefinition kind, string culture, string action, string before, string after, string example)
    {
        _editor ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Admin/MailTemplates.razor.js");
        var id = EditorId(kind.Kind, culture);
        var edit = await _editor.InvokeAsync<TextEdit?>(action, id, before, after, example);
        if (edit is null) return;
        _drafts[(kind.Kind, culture)].Body = edit.Value;
        StateHasChanged();
        await _editor.InvokeVoidAsync("select", id, edit.Start, edit.End);
    }

    private sealed record TextEdit(string Value, int Start, int End);

    private async Task<Guid> UserIdAsync() => (await AuthenticationState).User.Id();

    private async Task ResetAsync(MailKindDefinition kind, string culture)
    {
        await Templates.ResetAsync(kind.Kind, culture);
        _problems.Remove((kind.Kind, culture));
        _previews.Remove((kind.Kind, culture));
        Snackbar.Add($"{kind.Name} in het {LanguageName(culture)} gebruikt weer de standaardtekst.", Severity.Success);
        await LoadAsync(kind.Kind, culture);
    }

    private static string LanguageName(string culture) => culture switch
    {
        "nl" => "Nederlands",
        "fr" => "Frans",
        "en" => "Engels",
        _ => culture,
    };

    private static string Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, BelgianTime).ToString("dd/MM/yyyy HH:mm");
}
