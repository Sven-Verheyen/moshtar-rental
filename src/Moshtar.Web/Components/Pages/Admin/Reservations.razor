@page "/admin/reservaties"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Moshtar.Infrastructure.Persistence
@using Moshtar.Domain.Reviews
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IReservationService ReservationService
@inject IReservationAlternatives ReservationAlternatives
@inject ISnackbar Snackbar

<PageTitle>Reservaties</PageTitle>

<AdminShell Title="Reservaties">
    <MudButton Href="admin/reservaties/nieuw" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
        Nieuwe reservatie
    </MudButton>
    @if (!string.IsNullOrWhiteSpace(Number))
    {
        <MudText Class="mb-4">Reservatie @Number · <MudLink Href="admin/reservaties">Alle reservaties</MudLink></MudText>
    }
    <MudTable Items="_reservations" Loading="_reservations is null" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Nummer</MudTh>
            <MudTh>Klant</MudTh>
            <MudTh>Periode</MudTh>
            <MudTh>Inhoud</MudTh>
            <MudTh>Levering</MudTh>
            <MudTh>Totaal</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Number</MudTd>
            <MudTd>
                @context.Customer?.FirstName @context.Customer?.LastName<br /><small>@context.Customer?.Email</small>
                @if (context.Customer is { } customer && _optedOut.Contains(ReviewOptOut.Normalize(customer.Email)))
                {
                    <br /><small class="mud-text-secondary">Afgemeld voor reviewvragen</small>
                }
            </MudTd>
            <MudTd>@context.StartDate.ToString("dd/MM/yyyy") – @context.EndDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@string.Join(", ", context.Lines.Select(LineText))</MudTd>
            <MudTd>@(context.DeliveryMethod == DeliveryMethod.Delivery ? "Leveren" : "Afhalen")</MudTd>
            <MudTd>@context.TotalPrice.ToString("C", Money)</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip>
                @if (context.AlternativesMailedAtUtc is { } mailed)
                {
                    <br /><small>Alternatieven gemaild op @LocalTime(mailed)</small>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History"
                           OnClick="() => ToggleHistoryAsync(context.Id)">Historiek</MudButton>
                @if (context.Status != ReservationStatus.Cancelled)
                {
                    <MudMenu Label="Status" Size="Size.Small" Dense="true" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        @foreach (var status in NextStatuses.Where(s => s != context.Status))
                        {
                            <MudMenuItem OnClick="() => ChangeStatusAsync(context.Id, status)">@StatusLabel(status)</MudMenuItem>
                        }
                    </MudMenu>
                    @if (context.OccupiesStock)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                   OnClick="() => ToggleReplaceAsync(context.Id)">Artikel vervangen</MudButton>
                    }
                    @if (context.Status == ReservationStatus.Confirmed)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => ChangeStatusAsync(context.Id, ReservationStatus.Cancelled)">Annuleren</MudButton>
                    }
                }
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_replace.TryGetValue(context.Id, out var replace))
            {
                <MudTr>
                    <td colspan="8" class="reservation-replace" style="padding-left:2rem">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Kies het artikel dat je wil vervangen. Alleen artikelen uit dezelfde categorie die vrij zijn in de volledige
                            huurperiode komen in aanmerking. Zit het in een pakket, dan wordt het enkel binnen het pakket vervangen en
                            blijft de pakketprijs dezelfde; een meerprijs komt als aparte lijn.
                        </MudText>
                        <MudSelect T="Guid?" Label="Artikel" Value="replace.RentalItemId" ValueChanged="id => ChooseItemAsync(context.Id, id)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:28rem" Class="mb-2">
                            @foreach (var item in replace.Items)
                            {
                                <MudSelectItem T="Guid?" Value="item.RentalItemId">
                                    @item.Quantity × @item.Name@(item.BundleName is null ? "" : $" (in {item.BundleName})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                        @if (replace.RentalItemId is { } itemId && replace.Alternatives is { } alternatives)
                        {
                            <AlternativesPanel @key="(context.Id, itemId)" ReservationId="context.Id" RentalItemId="itemId"
                                               Alternatives="alternatives" OnMailed="LoadAsync" OnReplaced="() => ReplacedAsync(context.Id)" />
                        }
                    </td>
                </MudTr>
            }
            @if (_history.TryGetValue(context.Id, out var history))
            {
                <MudTr>
                    <td colspan="8" class="reservation-history">
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th scope="col">Tijdstip</th>
                                    <th scope="col">Gebeurtenis</th>
                                    <th scope="col">Door</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in history)
                                {
                                    <tr>
                                        <td>@LocalTime(entry.OccurredAtUtc)</td>
                                        <td>@EventLabel(entry)</td>
                                        <td>@(entry.UserEmail ?? (entry.Kind == ReservationEventKind.ReviewRequestMailed ? "automatisch" : "via website"))</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>Nog geen reservaties.</NoRecordsContent>
    </MudTable>
</AdminShell>

@code {
    private static readonly System.Globalization.CultureInfo Money = System.Globalization.CultureInfo.GetCultureInfo("nl-BE");
    private static readonly TimeZoneInfo BelgianTime = TimeZoneInfo.FindSystemTimeZoneById("Europe/Brussels");
    private List<Reservation>? _reservations;
    /// <summary>De klanten in de lijst die zich afmeldden voor reviewvragen, zodat je ziet waarom ze er geen kregen.</summary>
    private IReadOnlySet<string> _optedOut = new HashSet<string>();
    private readonly Dictionary<Guid, IReadOnlyList<ReservationHistoryEntry>> _history = [];
    private readonly Dictionary<Guid, ReplaceState> _replace = [];

    /// <summary>Het open paneel "Artikel vervangen" van een reservatie: haar artikelen en de alternatieven voor het gekozen artikel.</summary>
    private sealed class ReplaceState(IReadOnlyList<ReservedItem> items)
    {
        public IReadOnlyList<ReservedItem> Items { get; } = items;
        public Guid? RentalItemId { get; set; }
        public IReadOnlyList<Alternative>? Alternatives { get; set; }
    }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>Alleen de reservatie met dit nummer, bijvoorbeeld vanuit de lijst Tekorten.</summary>
    [SupplyParameterFromQuery(Name = "nummer")] public string? Number { get; set; }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var number = Number?.Trim();
        _reservations = await db.Reservations.AsNoTracking().Include(r => r.Customer)
            .Where(r => string.IsNullOrEmpty(number) || r.Number == number)
            .OrderByDescending(r => r.StartDate).ThenBy(r => r.Number)
            .Take(200).ToListAsync();
        var emails = _reservations.Where(r => r.Customer is not null).Select(r => ReviewOptOut.Normalize(r.Customer!.Email)).Distinct().ToList();
        _optedOut = (await db.ReviewOptOuts.AsNoTracking().Where(o => emails.Contains(o.Email)).Select(o => o.Email).ToListAsync()).ToHashSet();
    }

    private static readonly ReservationStatus[] NextStatuses =
        [ReservationStatus.Confirmed, ReservationStatus.Delivered, ReservationStatus.Returned, ReservationStatus.Completed];

    private async Task ChangeStatusAsync(Guid id, ReservationStatus status)
    {
        try
        {
            var reservation = await ReservationService.ChangeStatusAsync(id, status, await CurrentUserAsync());
            Snackbar.Add($"Reservatie {reservation.Number}: {StatusLabel(status).ToLowerInvariant()}.", Severity.Info);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        await LoadAsync();
        if (_history.ContainsKey(id))
            _history[id] = await ReservationService.GetHistoryAsync(id);
    }

    private async Task ToggleHistoryAsync(Guid id)
    {
        if (!_history.Remove(id))
            _history[id] = await ReservationService.GetHistoryAsync(id);
    }

    private async Task ToggleReplaceAsync(Guid id)
    {
        if (!_replace.Remove(id))
            _replace[id] = new ReplaceState(await ReservationAlternatives.GetReservedItemsAsync(id));
    }

    private async Task ChooseItemAsync(Guid reservationId, Guid? itemId)
    {
        if (!_replace.TryGetValue(reservationId, out var replace)) return;
        replace.RentalItemId = itemId;
        replace.Alternatives = null;
        if (itemId is { } id)
            replace.Alternatives = await ReservationAlternatives.GetAsync(reservationId, id);
    }

    private async Task ReplacedAsync(Guid id)
    {
        _replace.Remove(id);
        await LoadAsync();
        if (_history.ContainsKey(id))
            _history[id] = await ReservationService.GetHistoryAsync(id);
    }

    /// <summary>
    /// Een lijn met de artikelen die binnen het pakket vervangen zijn, bv. "1 × Kinderfeest (Jungle vervangen door Piraat)";
    /// een kortingslijn met haar bedrag, bv. "2e springkasteel 40% korting: −€ 40,00".
    /// </summary>
    private static string LineText(ReservationLine line) =>
        line.IsDiscount ? $"{line.Description}: −{(-line.LineTotal).ToString("C", Money)}" :
        $"{line.Quantity} × {line.Description}" + (line.Replacements.Count == 0 ? ""
            : $" ({string.Join(", ", line.Replacements.Select(r => $"{r.RentalItemName} vervangen door {r.ReplacementName}"))})");

    private async Task<ReservationActor> CurrentUserAsync() => (await AuthenticationState).User.AsReservationActor();

    private static string LocalTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, BelgianTime).ToString("dd/MM/yyyy HH:mm");

    private static string EventLabel(ReservationHistoryEntry entry) => entry.Kind switch
    {
        ReservationEventKind.Created => "Aangemaakt",
        ReservationEventKind.Cancelled => "Geannuleerd",
        ReservationEventKind.AddressCorrected => "Leveradres verbeterd",
        ReservationEventKind.PointConfirmed => "Speld op de kaart bevestigd",
        ReservationEventKind.ExpectedTimeMailed => "Verwacht tijdsvenster gemaild",
        ReservationEventKind.ReviewRequestMailed => "Reviewvraag gemaild",
        ReservationEventKind.ReviewRequestWhatsApp => "Reviewvraag via WhatsApp",
        ReservationEventKind.AlternativesMailed => entry.Note is { } note ? $"Alternatieven gemaild: {note}" : "Alternatieven gemaild",
        ReservationEventKind.ItemReplaced => entry.Note is { } replaced ? $"Artikel vervangen: {replaced}" : "Artikel vervangen",
        _ => $"Status gewijzigd naar {StatusLabel(entry.Status).ToLowerInvariant()}",
    };

    private static string StatusLabel(ReservationStatus s) => s switch
    {
        ReservationStatus.Confirmed => "Bevestigd",
        ReservationStatus.Delivered => "Geleverd",
        ReservationStatus.Returned => "Teruggebracht",
        ReservationStatus.Completed => "Afgerond",
        ReservationStatus.Cancelled => "Geannuleerd",
        _ => s.ToString(),
    };

    private static Color StatusColor(ReservationStatus s) => s switch
    {
        ReservationStatus.Confirmed => Color.Success,
        ReservationStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };
}
