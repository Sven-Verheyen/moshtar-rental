@page "/admin/bedrijfsgegevens"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Administrator)]
@using Moshtar.Application.Tenancy
@using Moshtar.Domain.Rounds
@inject IBusinessDetailsAdministration BusinessDetailsAdmin
@inject ISnackbar Snackbar

<PageTitle>Bedrijfsgegevens</PageTitle>

<AdminShell Title="Bedrijfsgegevens">
    <MudText Typo="Typo.body1" Class="mb-4">
        Deze gegevens staan onderaan elke pagina van je reservatiewebsite en op de contactpagina. Wat je leeg laat, verschijnt niet.
    </MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Adres en contact</MudText>
        <MudTextField @bind-Value="_s.Street" Label="Straat en nummer" Variant="Variant.Outlined" Class="mb-3" />
        <MudStack Row="true" Class="mb-3">
            <MudTextField @bind-Value="_s.PostalCode" Label="Postcode" Variant="Variant.Outlined" Style="max-width: 10rem" />
            <MudTextField @bind-Value="_s.City" Label="Gemeente" Variant="Variant.Outlined" />
        </MudStack>
        <MudTextField @bind-Value="_s.Email" Label="E-mailadres" Variant="Variant.Outlined" Class="mb-3" Required="true"
                      HelperText="Verplicht: klanten antwoorden op dit adres als ze je mails beantwoorden." />
        <MudTextField @bind-Value="_s.Phone" Label="Telefoonnummer" Variant="Variant.Outlined" Class="mb-3"
                      Placeholder="+32 475 12 34 56" HelperText="In internationaal formaat, met +32 voor een Belgisch nummer." />
        <MudTextField @bind-Value="_s.WhatsAppPhone" Label="WhatsApp-nummer" Variant="Variant.Outlined" Class="mb-3"
                      Placeholder="+32 475 12 34 56" HelperText="In internationaal formaat. Mag hetzelfde zijn als je telefoonnummer." />
        <MudTextField @bind-Value="_s.VatNumber" Label="Btw-nummer" Variant="Variant.Outlined" Placeholder="BE 0123.456.789" />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Sociale media en reviews</MudText>
        <MudTextField @bind-Value="_s.FacebookUrl" Label="Facebook" Variant="Variant.Outlined" Class="mb-3" Placeholder="https://www.facebook.com/jouwbedrijf" />
        <MudTextField @bind-Value="_s.InstagramUrl" Label="Instagram" Variant="Variant.Outlined" Class="mb-3" Placeholder="https://www.instagram.com/jouwbedrijf" />
        <MudTextField @bind-Value="_s.TikTokUrl" Label="TikTok" Variant="Variant.Outlined" Class="mb-3" Placeholder="@("https://www.tiktok.com/@jouwbedrijf")" />
        <MudTextField @bind-Value="_s.GoogleBusinessUrl" Label="Google-bedrijfsprofiel" Variant="Variant.Outlined"
                      HelperText="De link naar je bedrijf op Google, waar klanten je reviews lezen." />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Google Analytics</MudText>
        <MudTextField @bind-Value="_s.GoogleAnalyticsId" Label="GA4-meet-ID" Variant="Variant.Outlined" Placeholder="G-ABC123XYZ"
                      HelperText="Vind je in Google Analytics bij Beheer › Gegevensstreams. Leeg: geen Google Analytics en geen cookiebalk op je website." />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Werkgebied</MudText>
        <MudTextField @bind-Value="_serviceArea" Label="Gemeenten waar je levert" Variant="Variant.Outlined" Lines="6"
                      HelperText="Eén gemeente per regel." />
        <MudCheckBox @bind-Value="_s.OffersPickup" Label="Klanten kunnen zelf afhalen" Color="Color.Primary" Class="mt-2" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Zonder vinkje lever je altijd en krijgt de klant geen keuze.</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Rondes in de planning</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Hiermee berekent de planning de verwachte uren. Het vertrekuur kan je per dag nog aanpassen, de opbouw- of afbouwtijd per stop.
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3">
            <MudTextField @bind-Value="_deliveryDeparture" Label="Vertrekuur leverronde" InputType="InputType.Time" Variant="Variant.Outlined" Style="max-width: 12rem" />
            <MudTextField @bind-Value="_collectionDeparture" Label="Vertrekuur ophaalronde" InputType="InputType.Time" Variant="Variant.Outlined" Style="max-width: 12rem" />
        </MudStack>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudNumericField @bind-Value="_s.SetupMinutes" Label="Opbouwtijd (min)" Variant="Variant.Outlined" Min="0" Max="480" Style="max-width: 12rem" />
            <MudNumericField @bind-Value="_s.TeardownMinutes" Label="Afbouwtijd (min)" Variant="Variant.Outlined" Min="0" Max="480" Style="max-width: 12rem" />
            <MudNumericField @bind-Value="_s.WindowMinutes" Label="Breedte venster (min)" Variant="Variant.Outlined" Min="30" Max="240" Step="30"
                             Style="max-width: 12rem" HelperText="Per half uur, bv. 60 voor een venster van 1 uur." />
        </MudStack>
    </MudPaper>

    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @foreach (var problem in _problems)
            {
                <div>@problem</div>
            }
        </MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Opslaan</MudButton>
</AdminShell>

@code {
    private Form _s = new();
    private string? _serviceArea;
    private IReadOnlyList<string> _problems = [];
    private string? _deliveryDeparture, _collectionDeparture;

    /// <summary>Een uur uit een tijdveld (HH:mm); leeg of onleesbaar: de standaard.</summary>
    private static TimeOnly Time(string? value, TimeOnly fallback) =>
        TimeOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var time) ? time : fallback;

    protected override async Task OnInitializedAsync() => Show(await BusinessDetailsAdmin.GetAsync());

    private void Show(BusinessDetailsSettings s)
    {
        _s = new Form
        {
            Street = s.Street, PostalCode = s.PostalCode, City = s.City, Email = s.Email, Phone = s.Phone,
            WhatsAppPhone = s.WhatsAppPhone, VatNumber = s.VatNumber, FacebookUrl = s.FacebookUrl, InstagramUrl = s.InstagramUrl,
            TikTokUrl = s.TikTokUrl, GoogleBusinessUrl = s.GoogleBusinessUrl, GoogleAnalyticsId = s.GoogleAnalyticsId,
            OffersPickup = s.OffersPickup,
            SetupMinutes = s.Rounds.SetupMinutes, TeardownMinutes = s.Rounds.TeardownMinutes, WindowMinutes = s.Rounds.WindowMinutes,
        };
        _serviceArea = string.Join('\n', s.ServiceArea);
        _deliveryDeparture = s.Rounds.DeliveryDeparture.ToString("HH:mm");
        _collectionDeparture = s.Rounds.CollectionDeparture.ToString("HH:mm");
    }

    private async Task SaveAsync()
    {
        try
        {
            await BusinessDetailsAdmin.SaveAsync(new BusinessDetailsSettings
            {
                Street = _s.Street, PostalCode = _s.PostalCode, City = _s.City, Email = _s.Email, Phone = _s.Phone,
                WhatsAppPhone = _s.WhatsAppPhone, VatNumber = _s.VatNumber, FacebookUrl = _s.FacebookUrl, InstagramUrl = _s.InstagramUrl,
                TikTokUrl = _s.TikTokUrl, GoogleBusinessUrl = _s.GoogleBusinessUrl, GoogleAnalyticsId = _s.GoogleAnalyticsId,
                ServiceArea = Moshtar.Domain.Tenants.BusinessDetails.ServiceArea(_serviceArea),
                OffersPickup = _s.OffersPickup,
                Rounds = new RoundSettings(
                    Time(_deliveryDeparture, RoundSettings.Default.DeliveryDeparture), Time(_collectionDeparture, RoundSettings.Default.CollectionDeparture),
                    _s.SetupMinutes, _s.TeardownMinutes, _s.WindowMinutes),
            });
            _problems = [];
            Show(await BusinessDetailsAdmin.GetAsync());
            Snackbar.Add("Je bedrijfsgegevens zijn bewaard.", Severity.Success);
        }
        catch (BusinessDetailsException e)
        {
            _problems = e.Problems;
        }
    }

    /// <summary>De velden zoals ze in het scherm bewerkt worden.</summary>
    private sealed class Form
    {
        public string? Street { get; set; }
        public string? PostalCode { get; set; }
        public string? City { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? WhatsAppPhone { get; set; }
        public string? VatNumber { get; set; }
        public string? FacebookUrl { get; set; }
        public string? InstagramUrl { get; set; }
        public string? TikTokUrl { get; set; }
        public string? GoogleBusinessUrl { get; set; }
        public string? GoogleAnalyticsId { get; set; }
        public bool OffersPickup { get; set; }
        public int SetupMinutes { get; set; }
        public int TeardownMinutes { get; set; }
        public int WindowMinutes { get; set; }
    }
}
